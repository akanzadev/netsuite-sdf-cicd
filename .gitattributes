# Normalize line endings to LF in the repository
* text=auto eol=lf

# Force LF for these file types
*.js    text eol=lf
*.ts    text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf

# Binary files
*.png   binary
*.jpg   binary
*.gif   binary
